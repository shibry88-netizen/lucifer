{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUCIFER",
  "mainBinaryName": "LUCIFER",
  "version": "3.0.0",
  "identifier": "com.lucifer.chenxing",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LUCIFER",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0D0C0B",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
