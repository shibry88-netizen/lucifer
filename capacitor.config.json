{
  "appId": "com.lucifer.chenxing",
  "appName": "LUCIFER",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0D0C0B",
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#0D0C0B",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}